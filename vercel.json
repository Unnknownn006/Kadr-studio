{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/public/:path*", "destination": "https://kadr-backoffice.vercel.app/api/public/:path*" },
    { "source": "/media/:path*", "destination": "https://kadr-backoffice.vercel.app/media/:path*" },
    { "source": "/o/:path*", "destination": "https://kadr-backoffice.vercel.app/o/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
